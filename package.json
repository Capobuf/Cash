{
  "name": "cash-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente desktop locale per la preventivazione professionale",
  "author": "Cash",
  "main": "dist/native/main.cjs",
  "type": "module",
  "scripts": {
    "build:code": "node scripts/build.mjs",
    "build:code:dev": "node scripts/build.mjs --development",
    "build:styles": "tailwindcss -i ./src/renderer/styles.css -o ./dist/renderer/styles.css --minify",
    "build": "npm run build:code && npm run build:styles",
    "build:dev": "npm run build:code:dev && npm run build:styles",
    "generate:icon": "node scripts/generate-icon.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build:dev && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.config.{js,ts}\" \"*.json\" \".prettierrc.json\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.config.{js,ts}\" \"*.json\" \".prettierrc.json\" \".github/workflows/*.{yml,yaml}\"",
    "test:sqlite:electron": "node scripts/sqlite-smoke.mjs",
    "test:sqlite:portable": "node scripts/sqlite-smoke.mjs --packaged",
    "test:sqlite:installed": "node scripts/sqlite-smoke.mjs --installed"
  },
  "dependencies": {
    "@zowe/secrets-for-zowe-sdk": "8.38.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "decimal.js": "10.6.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "exceljs": "4.4.0",
    "globals": "16.3.0",
    "lucide-react": "^1.45.0",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  },
  "build": {
    "appId": "it.cash.desktop",
    "productName": "Cash",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@zowe/secrets-for-zowe-sdk/**/*"
    ],
    "win": {
      "icon": "src/renderer/assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Cash Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cash.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Capobuf",
        "repo": "Cash"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@zowe/secrets-for-zowe-sdk@8.38.0": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
