{
  "name": "cash-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente desktop locale per la preventivazione professionale",
  "author": "Cash",
  "main": "dist/native/main.cjs",
  "type": "module",
  "scripts": {
    "build:code": "node scripts/build.mjs",
    "build:styles": "tailwindcss -i ./src/renderer/styles.css -o ./dist/renderer/styles.css --minify",
    "build": "npm run build:code && npm run build:styles",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "decimal.js": "10.6.0",
    "keytar": "7.9.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "5.0.0"
  },
  "build": {
    "appId": "it.cash.desktop",
    "productName": "Cash",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/keytar/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Cash-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "electron-winstaller@5.4.0": true
  }
}
